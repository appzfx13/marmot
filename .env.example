# ==========================================
# Django Application Settings
# ==========================================
DEBUG=True

# Django Superuser Credentials
DJANGO_SUPERUSER_USERNAME=marmotadmin
DJANGO_SUPERUSER_EMAIL=admin@marmot.com
DJANGO_SUPERUSER_PASSWORD=your_superuser_password_here

# ==========================================
# Database Credentials (PostgreSQL)
# ==========================================
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_PORT=5432

# ==========================================
# Redis & Cache Settings
# ==========================================
REDIS_URL=redis://redis:6379/0

# ==========================================
# Real-Time Engine (Go Application)
# ==========================================
WS_PORT=8082
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# ==========================================
# Cloudinary Configuration
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ==========================================
# Application Configuration & Prefix
# ==========================================
PREFIX_TRADERS=TRD
PREFIX_ADMIN=ADM
PREFIX_MANAGER=MGR
PAGINATION_COUNT=10

# ==========================================
# OpenAlgo Integration
# ==========================================
OPENALGO_API_KEY=your_openalgo_key_here
OPENALGO_HOST=http://127.0.0.1:5000
