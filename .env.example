# ==========================================
# Core Application Settings
# ==========================================
SECRET_KEY=your_django_secret_key_here
OTP_SECRET_KEY=your_otp_secret_key_here
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=*,localhost,127.0.0.1,0.0.0.0,web
CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.ngrok.io,https://*.ngrok-free.dev,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8005,http://127.0.0.1:8005

# ==========================================
# WebSockets & Endpoints
# ==========================================
MARMOT_WS_URL=ws://localhost:8082/ws
WS_PORT=8082

# ==========================================
# Role-Based Access Control
# ==========================================
POSTBACK_VIEW_ROLES=admin,developer

# ==========================================
# Django Superuser Credentials
# ==========================================
DJANGO_SUPERUSER_USERNAME=marmotadmin
DJANGO_SUPERUSER_EMAIL=admin@marmot.com
DJANGO_SUPERUSER_PASSWORD=your_superuser_password_here

# ==========================================
# Database Configuration (Django & PostgreSQL)
# ==========================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mydatabase
DB_USER=myuser
DB_PASSWORD=your_db_password_here
DB_HOST=db
DB_PORT=5432

POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_PORT=5432

# ==========================================
# Redis & Cache Settings
# ==========================================
REDIS_URL=redis://redis_broker:6379/0

# ==========================================
# Cloudinary Configuration
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ==========================================
# Master Admin Dhan API Credentials
# ==========================================
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_API_KEY=your_dhan_api_key_here
DHAN_API_SECRET=your_dhan_api_secret_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# ==========================================
# OpenAlgo Integration
# ==========================================
OPENALGO_API_KEY=your_openalgo_key_here
OPENALGO_HOST=http://127.0.0.1:5000

# ==========================================
# Username Role Prefixes & Pagination
# ==========================================
PREFIX_TRADERS=TRD
PREFIX_ADMIN=ADM
PREFIX_MANAGER=MGR
PAGINATION_COUNT=10

# ==========================================
# Ngrok Tunnel Credentials
# ==========================================
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# ==========================================
# Email / SMTP Configuration
# ==========================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=Marmot Trading <noreply@marmot.local>

# ==========================================
# Twilio Configuration (Optional)
# ==========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# ==========================================
# Structured Logging Configuration
# ==========================================
LOG_RETENTION_DAYS=30

# ==========================================
# SSO / Social Account Providers (OAuth)
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ==========================================
# UI Theme Configuration
# Options: default, shadcn-zinc, shadcn-slate, shadcn-stone, shadcn-neutral, shadcn-violet
# ==========================================
UI_THEME=shadcn-zinc

