<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Dhan API</title>
    <link rel="icon" type="image/x-icon" href="https://dhan.co/images/favicon.ico">
    <!-- Embed elements Elements via Web Component -->
    <script src="https://unpkg.com/@stoplight/elements@8.3.4/web-components.min.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/@stoplight/elements@8.3.4/styles.min.css">
  </head>
  <body>

    <elements-api     
      apiDescriptionUrl="/v2/v3/api-docs"
      router="hash"
      layout="sidebar"
    />

  </body>
</html>

